# MSSQL Database Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to git!

DB_SERVER=your-database-server.database.windows.net
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_PORT=1433

# JWT Configuration
JWT_SECRET=generate-a-secure-random-key-minimum-256-bits
JWT_ISSUER=https://your-api-domain.com
JWT_AUDIENCE=https://your-frontend-domain.com
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Environment
ASPNETCORE_ENVIRONMENT=Development

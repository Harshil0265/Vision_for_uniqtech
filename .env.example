# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Vite requires env vars to be prefixed with VITE_ to expose them to the frontend
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Supabase Configuration (REQUIRED for backend API endpoints)
# If not provided, the app will gracefully fall back to localStorage for data persistence.
# To enable Supabase:
# 1. Create a project at https://supabase.com
# 2. Run the migration SQL from .agents/tasks/supabase-schema.sql in the SQL Editor
# 3. Copy your project URL and anon key from Settings > API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend Supabase Service Key (REQUIRED for server-side operations)
# This is the service_role key that bypasses RLS for admin operations
# Find it in Settings > API under "service_role" (not the anon key)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

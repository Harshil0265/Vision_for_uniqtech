# Frontend (Vite) settings. Copy to .env.local and adjust. None of these are secrets.

# How sign-in works:
#   auto  - use the .NET API; if it cannot be reached, fall back to offline demo accounts (default for `npm run dev`)
#   api   - always use the .NET API (default for production builds)
#   local - never call the API; offline demo accounts only (UI work without a backend)
# VITE_AUTH_MODE=auto

# Where the Vite dev server forwards /api/* requests (the .NET API, launch profile "http").
# VISION_API_URL=http://localhost:5286

# No third-party APIs or external services are required.
# Accounts are stored in a local JSON file; projects, issues and sprints live in the browser (localStorage).

# JWT authentication (REQUIRED in production)
# Secret used to sign access tokens. Generate one with:  npm run auth:secret
# In development a random one is generated at startup if this is missing (access tokens reset on restart).
JWT_ACCESS_SECRET=

# Port for the API server (default 3000)
# PORT=3000

# Where accounts and sessions are saved (default .data/auth.json). Back this file up, and keep it private.
# AUTH_DATA_FILE=.data/auth.json

# Who may sign up. Default: genuine Gmail addresses only.
# ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com   (use * to allow any domain)

# Optional tuning (seconds): access token lifetime, refresh token lifetime, hard session limit.
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800
# SESSION_MAX_AGE_SECONDS=2592000

# Set to true when running behind a reverse proxy so rate limits and session IPs use the real client IP.
# TRUST_PROXY=true
